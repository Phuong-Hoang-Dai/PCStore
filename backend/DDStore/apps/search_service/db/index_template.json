{
    "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "index.mapping.total_fields.limit": 2000,
    "analysis": {
        "filter": {
            "shingle": { "type": "shingle", "min_shingle_size": 2, "max_shingle_size": 3 }
        },
        "analyzer": {
            "trigram_analyzer": { "type": "custom", "tokenizer": "standard", "filter": ["lowercase", "shingle"] },
            "reverse_analyzer": { "type": "custom", "tokenizer": "standard", "filter": ["lowercase", "reverse"] }
        }
    }
    },
    "mappings": {
        "dynamic": "strict",
        "_source": {
            "enabled": true
        },
        "properties": {
            "id": {
                "type": "keyword"
            },
            "name": {
                "type": "text",
                "fields": {
                    "keyword": { "type": "keyword", "ignore_above": 256},
                    "trigram": { "type": "text", "analyzer": "trigram_analyzer" },
                    "reverse": { "type": "text", "analyzer": "reverse_analyzer" }
                }
            },
            "description": {
                "type": "text"
            },
            "brand": {
                "type": "text",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "cate": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "keyword"
                    }
                }
            },
            "price": {
                "type": "float"
            },
            "type": {
                "type": "keyword"
            },
            "images": {
                "properties": {
                    "url": {
                        "type": "keyword",
                        "index": false
                    },
                    "role": {
                        "type": "keyword"
                    }
                }
            },
            "upgrade": {
                "type": "object",
                "enabled": false
            },
            "created_at": {
                "type": "date"
            },
            "updated_at": {
                "type": "date"
            }
        }
    }
}