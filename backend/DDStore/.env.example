# Copy to .env (next to docker-compose.yaml); docker compose reads it automatically.

# Signs login cookies. Use a long random value outside local development.
JWT_SECRET=change-me

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by: stripe listen --forward-to localhost:7777/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# For the ngrok tunnel (docker compose --profile tunnel up -d ngrok):
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional fixed URL, e.g. https://your-name.ngrok-free.app (https://dashboard.ngrok.com/domains)
NGROK_URL=
